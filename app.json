{
  "expo": {
    "name": "Money Tracker",
    "slug": "money-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "moneytracker",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B3D2E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.shiva.moneytracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B3D2E"
      },
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true
    },
    "newArchEnabled": false,
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#0B3D2E"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Budget",
              "label": "Money Tracker budget",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "This month's spending vs budget",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Safe",
              "label": "Money Tracker — safe to spend",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "How much you can spend today",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-font"
    ]
  }
}
